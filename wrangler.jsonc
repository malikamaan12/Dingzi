{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dingzi-menu",
  "account_id": "8c6a1df16f0c1df63f5b501a8902da63",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "bbb3e53971814cb8a74925b02c7558e0" }],
  "preview_urls": false,
  "placement": { "region": "aws:ap-northeast-1" },
  "minify": true,
  "alias": {
    "./db": "./server/workerDatabase.ts",
    "./passwords": "./server/workerPasswords.ts",
    "./mediaStore": "./server/workerMediaStore.ts",
    "iconv-lite": "./node_modules/iconv-lite/lib/index.js"
  },
  "vars": {
    "APPLICATION_SURFACE": "public",
    "NODE_ENV": "production",
    "CAFE_RUNTIME": "workers",
    "COOKIE_SECURE": "true",
    "TRUST_PROXY": "true",
    "TZ": "UTC",
    "STORAGE_BUCKET": "pager-media",
    "PUBLIC_MENU_ORIGIN": "https://dingzi-menu.amaanmalik12.workers.dev",
    "MANAGEMENT_ORIGIN": "https://dingzi-staff.amaanmalik12.workers.dev"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [{ "name": "BRANCH_HUB", "class_name": "BranchRealtimeDO", "script_name": "dingzi-staff" }]
  },
  "observability": { "enabled": true }
  // Bind a NEW Cloudflare account_id and Hyperdrive ID using scripts/configure-cloud.mjs.
  // Never connect this project to the legacy Cafe Menu account or database.
}
